{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:single": "SINGLE_FILE=1 vite build",
    "release": "node scripts/release.mjs",
    "android:sync": "node scripts/sync-android-version.mjs && vite build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "sim": "vite-node scripts/simulate-battle.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.70.0",
    "phaser": "^3.88.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^3.2.7"
  }
}
